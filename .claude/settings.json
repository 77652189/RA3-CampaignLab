{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_inline_edits.py\"",
            "timeout": 10,
            "statusMessage": "Checking for fragile inline edits"
          }
        ]
      }
    ]
  }
}
